<Window x:Class="RimeUIEditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:view="clr-namespace:RimeUIEditor.View"
        xmlns:local="clr-namespace:RimeUIEditor"
        Title="Rime UI Editor" Width="1600" Height="980" Background="#FF1E1E1E">
    <Window.InputBindings>
        <KeyBinding Key="Z" Modifiers="Ctrl" Command="ApplicationCommands.Undo" />
        <KeyBinding Key="Y" Modifiers="Ctrl" Command="ApplicationCommands.Redo" />
        <KeyBinding Key="S" Modifiers="Ctrl" Command="ApplicationCommands.Save" />
        <KeyBinding Key="C" Modifiers="Ctrl" Command="ApplicationCommands.Copy" />
        <KeyBinding Key="V" Modifiers="Ctrl" Command="ApplicationCommands.Paste" />
        <KeyBinding Key="D" Modifiers="Ctrl" Command="{x:Static local:MainWindow.DuplicateCommand}" />
        <KeyBinding Key="Delete" Command="ApplicationCommands.Delete" />
    </Window.InputBindings>
    <Window.CommandBindings>
        <CommandBinding Command="ApplicationCommands.Undo" Executed="OnUndo" />
        <CommandBinding Command="ApplicationCommands.Redo" Executed="OnRedo" />
        <CommandBinding Command="ApplicationCommands.Save" Executed="OnSaveCommand" />
        <CommandBinding Command="ApplicationCommands.Copy" Executed="OnCopyCommand" />
        <CommandBinding Command="ApplicationCommands.Paste" Executed="OnPasteCommand" />
        <CommandBinding Command="{x:Static local:MainWindow.DuplicateCommand}" Executed="OnDuplicateCommand" />
        <CommandBinding Command="ApplicationCommands.Delete" Executed="OnDeleteCommand" />
    </Window.CommandBindings>
    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" MinHeight="200"/>
            <RowDefinition Height="5"/>
            <RowDefinition Height="150" MinHeight="40"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- toolbar -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Background="{StaticResource PanelBrush}" Margin="0" >
            <Button x:Name="MountButton" Content="Mount game" Margin="8,4" Padding="8,2" Click="OnMount"/>
            <Button Content="Settings…" Margin="4" Padding="8,2" Click="OnOpenSettings"/>
            <Separator Width="12" Visibility="Hidden"/>
            <Button Content="New screen" Margin="4" Padding="8,2" Click="OnNewScreen" ToolTip="A screen made from nothing (the game's empty screen cloned under your name): its movie and its partition ship as new entries of the mod. Show it from a flow graph with a StateNode."/>
            <Button Content="New mod" Margin="4" Padding="8,2" Click="OnNewDocument" ToolTip="Start a fresh document (a new mod): forgets every edit and every new screen."/>
            <Button Content="Open…" Margin="4" Padding="8,2" Click="OnOpenDocument"/>
            <Button x:Name="SaveButton" Content="Save" Margin="4" Padding="8,2" Click="OnSaveDocument" ToolTip="Save the document to its file (Ctrl+S). Disabled until Save as… has given it one."/>
            <Button Content="Save as…" Margin="4" Padding="8,2" Click="OnSaveAsDocument" ToolTip="Choose where the document (this session's changes) is saved; Save then writes there without asking."/>
            <Separator Width="12" Visibility="Hidden"/>
            <Button x:Name="UndoButton" Content="Undo" Margin="4" Padding="8,2" Click="OnUndoClick" ToolTip="Undo the last change to the document (Ctrl+Z)."/>
            <Button x:Name="RedoButton" Content="Redo" Margin="4" Padding="8,2" Click="OnRedoClick" ToolTip="Redo (Ctrl+Y)."/>
            <Separator Width="12" Visibility="Hidden"/>
            <Button x:Name="RuffleButton" Content="Preview" Margin="4" Padding="8,2" Click="OnRufflePreview" ToolTip="Plays the open screen with your edits in Ruffle (an open-source Flash player) running the game's own ActionScript inside the editor: the widgets build themselves, hover and press animate, static texts show, the screen graph runs on every event. Widgets fed from game data show that data once a recording of the screen is imported (Record data… / Import recording…)."/>
            <Button x:Name="RecordButton" Content="Record data…" Margin="4" Padding="8,2" Click="OnRecordData" ToolTip="Writes the RimeUiRecorder mod for the open screen into the Mods folder: the screen's shipped movie with a recorder in front of its frame, which sends everything the game hands the screen (each widget's init data, every data refresh, the component answers) into the client console. Enable it in ModList.txt, disable any other mod that ships this screen, open the screen in the game, copy the console, then Import recording…"/>
            <Button x:Name="ImportRecordingButton" Content="Import recording…" Margin="4" Padding="8,2" Click="OnImportRecording" ToolTip="Reads the copied client console (the clipboard, or a text file) with the [AS2] #R… lines the recorder mod printed, and keeps them as the screen's data for Preview."/>
            <Button x:Name="BuildButton" Content="Build mod…" Margin="4" Padding="12,2" FontWeight="Bold" Click="OnBuild" ToolTip="Asks what the mod is and where it goes, then writes a complete VU mod (mod.json, ext/, sb/) into the Mods folder."/>
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" Margin="16,4" Foreground="Khaki"/>
            <TextBlock x:Name="PathsText" VerticalAlignment="Center" Margin="16,4" Foreground="Gray" FontSize="11"/>
        </StackPanel>

        <!-- body: three columns, both dividers draggable -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" MinWidth="160"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*" MinWidth="200"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="380" MinWidth="220"/>
            </Grid.ColumnDefinitions>

            <!-- left: layers over the data explorer. The splitter's neighbours are both star rows (each label lives
                 inside its row): a label in an Auto row between them turns into a dead band when dragged. -->
            <Grid Grid.Column="0" Background="{StaticResource PanelBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="2*" MinHeight="60"/>
                    <RowDefinition Height="5"/>
                    <RowDefinition Height="3*" MinHeight="120"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="6,4,6,2" LastChildFill="False">
                        <TextBlock Text="Layers" FontWeight="Bold" VerticalAlignment="Center"/>
                        <Button DockPanel.Dock="Right" x:Name="LayerBackButton" Content="▼" Padding="5,0" FontSize="10" Margin="2,0,0,0" Click="OnLayerBackward"
                                ToolTip="Send the selected clip one step back (behind the next one below it in its sprite): a depth op, the game draws it under"/>
                        <Button DockPanel.Dock="Right" x:Name="LayerFrontButton" Content="▲" Padding="5,0" FontSize="10" Click="OnLayerForward"
                                ToolTip="Bring the selected clip one step forward (over the next one above it in its sprite): a depth op, the game draws it on top"/>
                    </DockPanel>
                    <ListBox Grid.Row="1" x:Name="LayerList" Margin="6,0,6,4" SelectionChanged="OnLayerSelected" FontSize="11"
                             ToolTip="The stage placements, topmost first: what is higher in the list draws in front (its depth). ▲ ▼ move the selected one; Properties ▸ Placement ▸ Depth takes a number. Eye = drawn, lock = not pickable on the stage."/>
                </Grid>
                <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                              Background="#FF3F3F46" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext"/>
                <Grid Grid.Row="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="2*" MinHeight="40"/>
                        <RowDefinition Height="5"/>
                        <RowDefinition Height="3*" MinHeight="40"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Data Explorer" FontWeight="Bold" Margin="6,4,6,2"/>
                    <Grid Grid.Row="1" Margin="6,0,6,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" x:Name="ScreenFilter" TextChanged="OnScreenFilter"
                                 ToolTip="Search every UI partition by name (ui/flow, ui/assets, ui/uicomponents…); empty = browse the folder tree."/>
                        <ComboBox Grid.Column="1" x:Name="TypeFilter" Width="128" Margin="4,0,0,0" FontSize="11" SelectionChanged="OnTypeFilter"
                                  ToolTip="Show every partition of one type, whatever its folder (all the screens = UIScreenAsset, all the flow graphs = UIGraphAsset, the widgets, the data components…)."/>
                    </Grid>
                    <TreeView Grid.Row="2" x:Name="ExplorerTree" Margin="6,0,6,0" FontSize="11" Background="#FF17191C" Foreground="#FFDDDDDD" BorderBrush="#FF5A6068"
                              SelectedItemChanged="OnExplorerFolder"/>
                    <GridSplitter Grid.Row="3" Height="5" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                  Background="#FF3F3F46" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext"/>
                    <ListView Grid.Row="4" x:Name="ScreenList" Margin="6,0,6,6" FontSize="11" Background="#FF17191C" Foreground="#FFDDDDDD" BorderBrush="#FF5A6068"
                              SelectionChanged="OnScreenSelected" MouseDoubleClick="OnExplorerDoubleClick"
                              PreviewMouseLeftButtonDown="OnDragSourceDown" PreviewMouseMove="OnDragSourceMove" PreviewMouseLeftButtonUp="OnExplorerMouseUp"
                              ToolTip="Click a screen or flow graph to open it; double-click a widget asset to add it to the open screen. Drag a widget onto the stage, a screen or a component onto the graph, any partition onto a reference field.">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Name" Width="170" DisplayMemberBinding="{Binding Name}"/>
                                <GridViewColumn Header="Type" Width="140" DisplayMemberBinding="{Binding Type}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Grid>
            </Grid>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="#FF3F3F46" ResizeBehavior="PreviousAndNext"/>

            <!-- centre: the open screens as tabs, then stage | graph -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <ScrollViewer Grid.Row="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Background="#FF232326">
                    <StackPanel x:Name="OpenTabs" Orientation="Horizontal" Margin="2,2,2,0"/>
                </ScrollViewer>
            <TabControl Grid.Row="1" x:Name="CentreTabs" Background="#FF0A0A0A" BorderThickness="0" Padding="0" SelectionChanged="OnCentreTab">
            <TabItem Header="Stage">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <DockPanel Background="{StaticResource PanelBrush}">
                    <TextBlock Text="Zoom" VerticalAlignment="Center" Margin="8,2"/>
                    <Slider x:Name="ZoomSlider" Minimum="0.15" Maximum="4" Value="0.75" Width="140" ValueChanged="OnZoom" VerticalAlignment="Center"
                            ToolTip="Zoom around the centre of the view. The wheel over the stage zooms toward the cursor."/>
                    <TextBlock x:Name="ZoomText" VerticalAlignment="Center" Margin="6,2" Width="42" Foreground="Gray" FontSize="11"/>
                    <Button Content="Fit" Margin="4,2" Padding="8,1" Click="OnFit" ToolTip="Whole stage on screen (F)."/>
                    <Button Content="1:1" Margin="0,2" Padding="8,1" Click="OnZoomOne" ToolTip="Stage pixels = screen pixels (Ctrl+0)."/>
                    <CheckBox x:Name="ShowArtBox" Content="Art" IsChecked="True" VerticalAlignment="Center" Margin="12,2,4,2" Foreground="#FFDDDDDD" Checked="OnShowArt" Unchecked="OnShowArt"
                              ToolTip="Draw the movies as the game shows them on frame 1 (shapes, atlas bitmaps, text). Runtime-filled content stays empty."/>
                    <CheckBox x:Name="ShowOutlinesBox" Content="Outlines" IsChecked="True" VerticalAlignment="Center" Margin="4,2" Foreground="#FFDDDDDD" Checked="OnShowOutlines" Unchecked="OnShowOutlines"
                              ToolTip="Draw the placement boxes (selection and dragging keep working with them off)."/>
                    <CheckBox x:Name="ShowInnerBox" Content="All clips" IsChecked="False" VerticalAlignment="Center" Margin="4,2" Foreground="#FFDDDDDD" Checked="OnShowInner" Unchecked="OnShowInner"
                              ToolTip="Outline every clip inside the widgets too (their text fields, panels, icons — the widget movie's own placements). Not selectable: they belong to the widget."/>
                    <CheckBox x:Name="ShowRotationBox" Content="Rotation" IsChecked="False" VerticalAlignment="Center" Margin="4,2" Foreground="#FFDDDDDD" Checked="OnShowRotation" Unchecked="OnShowRotation"
                              ToolTip="Draw each placement's local x axis from its origin, with the angle when rotated or skewed."/>
                    <TextBlock Text="wheel zoom · RMB/MMB pan · F fit" VerticalAlignment="Center" Margin="12,2" Foreground="Gray" FontSize="10"/>
                    <TextBlock x:Name="ScreenTitle" VerticalAlignment="Center" Margin="16,2" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                </DockPanel>
                <view:StageViewport Grid.Row="1" x:Name="Viewport"/>
            </Grid>
            </TabItem>
            <TabItem Header="Graph">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <DockPanel Background="{StaticResource PanelBrush}">
                    <Button Content="Fit" Margin="8,2,4,2" Padding="8,1" Click="OnGraphFit" ToolTip="Whole graph on screen (F)."/>
                    <TextBlock Text="Add node" VerticalAlignment="Center" Margin="12,2,4,2"/>
                    <ComboBox x:Name="NodeTypeBox" Width="190" VerticalAlignment="Center" FontSize="11"/>
                    <Button Content="Add" Margin="4,2" Padding="8,1" Click="OnAddNode" ToolTip="Adds a node of that type to the document (its ports come from the game's type; fill its fields on the right)."/>
                    <TextBlock Text="drag a box to move · Ctrl+click or a band on empty graph selects several (a drag moves the lot) · drag from a yellow output dot to a blue input dot to wire (compatible inputs light up; hollow dots = the widget's contract) · Alt+click a wire to disconnect it · click to edit" VerticalAlignment="Center" Margin="12,2" Foreground="Gray" FontSize="10"/>
                    <TextBlock x:Name="GraphTitle" VerticalAlignment="Center" Margin="16,2" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                </DockPanel>
                <view:StageViewport Grid.Row="1" x:Name="GraphViewport"/>
            </Grid>
            </TabItem>
            </TabControl>
            <!-- the empty centre says what to do, on whichever tab is up: a blank frame reads as "broken" -->
            <Border Grid.Row="1" x:Name="EmptyHint" IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center" Background="#DD1E1E1E" BorderBrush="#FF3F3F46" BorderThickness="1" Padding="18,12" MaxWidth="560">
                <TextBlock TextAlignment="Center" Foreground="#FFC8CED6" FontSize="13" TextWrapping="Wrap"
                           Text="No screen is open.&#x0a;&#x0a;Click a screen in the Data Explorer on the left (folder ui / flow / screen, or type a name in the search box above the list) — or press New screen to make one from nothing. Its clips appear on the Stage and in Layers, its nodes on the Graph tab. The screens you leave open come back on the next start."/>
            </Border>
            </Grid>

            <GridSplitter Grid.Column="3" Width="5" HorizontalAlignment="Stretch" Background="#FF3F3F46" ResizeBehavior="PreviousAndNext"/>

            <!-- right: properties over the palette, draggable divider -->
            <Grid Grid.Column="4" Background="{StaticResource PanelBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="3*" MinHeight="80"/>
                    <RowDefinition Height="5"/>
                    <RowDefinition Height="1*" MinHeight="100"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="8,4,8,2">
                        <TextBlock FontWeight="Bold" VerticalAlignment="Center"><Run Text="Properties"/><Run x:Name="PropertiesTitle" FontWeight="Normal" Foreground="#FFDDDDDD" Text=""/></TextBlock>
                        <CheckBox x:Name="AlphabeticalBox" Content="A→Z" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#FFDDDDDD" FontSize="10"
                                  Checked="OnAlphabetical" Unchecked="OnAlphabetical" ToolTip="Sort the rows of each category alphabetically instead of the type's declaration order."/>
                    </DockPanel>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <view:PropertyGrid x:Name="PropertiesGrid" Margin="4,0,4,4"/>
                    </ScrollViewer>
                </Grid>
                <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                              Background="#FF3F3F46" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext"/>
                <TabControl Grid.Row="2" x:Name="ToolboxTabs" Background="{StaticResource PanelBrush}" BorderThickness="0" Padding="0" Margin="4,2,4,4">
                    <TabItem Header="Widgets">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Margin="4,4">
                                <TextBlock Text="Widget palette (ui/assets) — drag onto the stage" FontWeight="Bold" FontSize="11"/>
                                <TextBox x:Name="PaletteFilter" TextChanged="OnPaletteFilter"/>
                            </StackPanel>
                            <ListBox Grid.Row="1" x:Name="PaletteList" Margin="4,0" FontSize="11" MouseDoubleClick="OnAddWidget"
                                     PreviewMouseLeftButtonDown="OnDragSourceDown" PreviewMouseMove="OnDragSourceMove"/>
                            <Button Grid.Row="2" Content="Add selected widget to screen" Padding="6,3" Margin="4,4,4,4" Click="OnAddWidget"/>
                        </Grid>
                    </TabItem>
                    <TabItem Header="Nodes">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Node types — drag onto the graph" FontWeight="Bold" FontSize="11" Margin="4,4"/>
                            <ListBox Grid.Row="1" x:Name="NodeToolbox" Margin="4,0,4,4" FontSize="11" MouseDoubleClick="OnAddNodeFromToolbox"
                                     PreviewMouseLeftButtonDown="OnDragSourceDown" PreviewMouseMove="OnDragSourceMove"
                                     ToolTip="Every node type the game's type information knows. Drag one onto the graph (or double-click) to add it."/>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Grid>
        </Grid>

        <GridSplitter Grid.Row="2" Height="5" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                      Background="#FF3F3F46" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext"/>

        <!-- log -->
        <TextBox Grid.Row="3" x:Name="LogBox" IsReadOnly="True" FontFamily="Consolas" FontSize="11"
                 Background="#FF141414" Foreground="LightGray" VerticalScrollBarVisibility="Auto" TextWrapping="NoWrap"/>

        <!-- status bar: where you are, what is selected -->
        <DockPanel Grid.Row="4" Background="#FF2D2D30" LastChildFill="True">
            <TextBlock x:Name="StatusRight" DockPanel.Dock="Right" Margin="8,2" Foreground="Silver" FontSize="11"/>
            <TextBlock x:Name="StatusLeft" Margin="8,2" Foreground="Silver" FontSize="11" TextTrimming="CharacterEllipsis"/>
        </DockPanel>
    </Grid>
</Window>
